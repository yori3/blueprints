{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": true,
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "サイト名をここに入力",
        "blogdescription": "サイトの説明をここに入力",
        "WPLANG": "ja",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://YOUR_HOST/YOUR_PATH/content.xml"
      }
    }
  ]
}
